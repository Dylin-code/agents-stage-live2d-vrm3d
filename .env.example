VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000
VITE_FRONTEND_HOST=0.0.0.0
VITE_FRONTEND_PORT=5173
# 反向代理 / 內網 DNS 使用：逗號分隔的 host 白名單（例：dev.example.com,stage.example.com），或填 "all" 關閉檢查
# VITE_ALLOWED_HOSTS=
# Web Terminal（等同於將後端主機的完整 shell 暴露至瀏覽器，請謹慎啟用）
WEB_TERMINAL_ENABLED=false
WEB_TERMINAL_MAX_SESSIONS=2