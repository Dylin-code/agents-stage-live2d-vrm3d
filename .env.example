VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000
VITE_FRONTEND_HOST=0.0.0.0
VITE_FRONTEND_PORT=5173
# 反向代理 / 內網 DNS 使用：逗號分隔的 host 白名單（例：dev.example.com,stage.example.com），或填 "all" 關閉檢查
# VITE_ALLOWED_HOSTS=
# Web Terminal（等同於將後端主機的完整 shell 暴露至瀏覽器，請謹慎啟用）
WEB_TERMINAL_ENABLED=false
WEB_TERMINAL_MAX_SESSIONS=2

# 總控 Agent LLM provider: anthropic | openai | local
MASTER_AGENT_LLM_PROVIDER=openai
# Provider 對應 model，例：gpt-4o-mini / claude-sonnet-4-6 / qwen2.5:14b
MASTER_AGENT_LLM_MODEL=
# Anthropic / OpenAI key；local 可省略
MASTER_AGENT_LLM_API_KEY=
# local 模式必填，例 http://localhost:11434/v1
# MASTER_AGENT_LLM_BASE_URL=

# Telegram bot（總控 Agent TG 整合）— 留空代表停用
TELEGRAM_BOT_TOKEN=
# 選填，bot 帳號（不含 @），前端顯示直連用
# TELEGRAM_BOT_USERNAME=
# 選填，逗號分隔 TG numeric user id 白名單；留空 = 任何人都可綁定
# TELEGRAM_ALLOWED_USERS=